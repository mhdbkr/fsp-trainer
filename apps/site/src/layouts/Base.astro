---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MobileCtaBar from '@/components/MobileCtaBar.astro';
import { readSite } from '@/lib/site.ts';
import { jsonLdOrganization, jsonLdWebSite } from '@/lib/seo.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object[];
  noHeroCta?: boolean;
}

const { title, description, path, jsonLd: pageJsonLd = [] } = Astro.props;
const site = readSite();
const canonical = new URL(path, Astro.site).href;
const siteUrl = Astro.site!.href;
const jsonLd = [jsonLdOrganization(site, siteUrl), jsonLdWebSite(site, siteUrl), ...pageJsonLd];

if (title.length > 60) throw new Error(`title > 60 : ${path}`);
if (description.length > 155) throw new Error(`description > 155 : ${path}`);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="de" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  {!site.public && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-default.png', Astro.site).href} />
  <meta property="og:locale" content="de_DE" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {site.analyticsProvider === 'umami'
    ? <script defer src="/analytics.js" data-website-id={site.domain} data-host-url={site.analyticsEndpoint} />
    : <script defer src="/analytics.js" data-domain={site.domain} data-api={site.analyticsEndpoint} />}
  <ClientRouter />
</head>
<body class="min-h-dvh flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only">Zum Inhalt</a>
  <Header />
  <main id="main" class="flex-1 pb-24 md:pb-0"><slot /></main>
  <Footer />
  <MobileCtaBar />
</body>
</html>
