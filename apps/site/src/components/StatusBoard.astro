---
import status from '@/data/status.json' with { type: 'json' };

type Incident = { date: string; description: string };
const incidents: Incident[] = status.incidents;

const updatedAtLabel = new Intl.DateTimeFormat('de-DE', { dateStyle: 'short' }).format(
  new Date(status.updatedAt),
);

const STATE_LABELS: Record<string, string> = {
  operational: 'Funktioniert',
  degraded: 'Eingeschränkt',
  outage: 'Ausfall',
  maintenance: 'Wartung',
};

const STATE_DOT: Record<string, string> = {
  operational: 'bg-emerald-600',
  degraded: 'bg-amber-600',
  outage: 'bg-red-600',
  maintenance: 'bg-brand-600',
};

function labelFor(state: string): string {
  return STATE_LABELS[state] ?? state;
}

function dotFor(state: string): string {
  return STATE_DOT[state] ?? 'bg-ink-600';
}
---

<div class="rounded-control border border-ink-600/15 dark:border-paper/20">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-ink-600/15 px-4 py-3 dark:border-paper/20">
    <p class="text-sm text-ink-700 dark:text-paper/90">
      Manuell gepflegt — Stand <time datetime={status.updatedAt}>{updatedAtLabel}</time>.
    </p>
  </div>

  <ul class="divide-y divide-ink-600/15 dark:divide-paper/20">
    {status.components.map((c) => (
      <li class="flex items-center justify-between gap-4 px-4 py-3">
        <span class="text-ink dark:text-paper">{c.label}</span>
        <span class="inline-flex items-center gap-2 text-sm text-ink-700 dark:text-paper/90">
          <span class={`h-2.5 w-2.5 rounded-full ${dotFor(c.state)}`} aria-hidden="true"></span>
          {labelFor(c.state)}
        </span>
      </li>
    ))}
  </ul>

  <div class="border-t border-ink-600/15 px-4 py-4 dark:border-paper/20">
    <h2 class="text-sm font-medium text-ink dark:text-paper">Vorfälle</h2>
    {incidents.length === 0 ? (
      <p class="mt-1 text-sm text-ink-700 dark:text-paper/90">Keine Vorfälle.</p>
    ) : (
      <ul class="mt-2 space-y-2">
        {incidents.map((i) => (
          <li class="text-sm text-ink-700 dark:text-paper/90">{i.date} — {i.description}</li>
        ))}
      </ul>
    )}
  </div>
</div>
