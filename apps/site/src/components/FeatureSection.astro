---
interface Props {
  title: string;
  kicker: string;
  proof?: string;
  status: 'live' | 'bald';
  image?: { src: string; alt: string; width: number; height: number };
}

const { title, kicker, proof, status, image } = Astro.props;
---

<div class="flex flex-col rounded-card border border-ink-600/15 p-6 dark:border-paper/15">
  <div class="flex items-start justify-between gap-2">
    <p class="text-xs uppercase tracking-wide text-ink-600 dark:text-paper/80">{kicker}</p>
    {status === 'bald' && (
      <span class="rounded-control bg-brand-50 px-1.5 py-0.5 text-xs text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">bald</span>
    )}
  </div>
  <h3 class="mt-1 text-lg text-ink dark:text-paper">{title}</h3>
  {proof && <p class="mt-2 text-sm text-ink-700 dark:text-paper/90">{proof}</p>}
  {image && (
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="lazy"
      class="mt-4 rounded-control"
    />
  )}
</div>
