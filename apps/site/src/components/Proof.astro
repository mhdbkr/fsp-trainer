---
import frequencies from '@/data/frequencies.json' with { type: 'json' };

// Top 5 réel des fréquences observées (total desc).
// review T2.3 I2 : copie avant tri — `pathologies` est un module JSON partagé
// (FreqTable.astro le relit ailleurs dans le même build), `sort` en place
// rendait l'ordre des ex æquo dépendant de l'ordre de rendu des pages.
const top5 = [...frequencies.pathologies]
  .sort((a, b) => (b.total ?? 0) - (a.total ?? 0))
  .slice(0, 5);
---

<section id="produkt" class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="text-2xl md:text-3xl text-ink dark:text-paper">Was wirklich drankommt, zentrumsweise</h2>
  <p class="mt-2 max-w-2xl text-ink-700 dark:text-paper/90">
    Hier die fünf Pathologien, die in Baden-Württemberg am häufigsten gemeldet werden.
  </p>

  {/* Correction de revue (I7) : l'en-tête « Berichte » et l'effectif absolu livraient la
      taille du corpus, ici comme sur /de/was-drankommt/. Cinq noms dans l'ordre portent
      l'analyse ; l'effectif ne portait que la reconstitution. */}
  <ol class="mt-6 max-w-xl space-y-2">
    {top5.map((p, i) => (
      <li class="flex gap-3 border-b border-ink-600/10 py-2 dark:border-paper/10">
        <span class="font-mono text-sm text-brand-700 dark:text-brand-300">{i + 1}</span>
        <span class="text-ink-800 dark:text-paper">{p.name}</span>
      </li>
    ))}
  </ol>

  {/* Jamais `frequencies.disclaimer` : la donnée générée nomme le corpus
      (« … in Prüfungsprotokollen ») et révèle ainsi le sourcing (tâche 5, étape 3).
      Libellé DE en dur, même parti pris que pour `frequencies.source`. */}
  <p class="mt-4 max-w-xl text-sm text-ink-600 dark:text-paper/80">
    Beobachtete Häufigkeiten, keine Vorhersage.
  </p>

  <a href="/de/was-drankommt/" class="link mt-4 inline-block">
    Alle Häufigkeiten ansehen
  </a>
</section>
