---
import frequencies from '@/data/frequencies.json' with { type: 'json' };

// `trends[].summary` porte des `**gras**` markdown minimal (donnée FR
// d'origine, reprise textuellement — contrat §5) : on le rend en <strong>
// plutôt que d'afficher les astérisques bruts (review-T1.1, mineur).
function renderBold(text: string) {
  return text.split(/(\*\*[^*]+\*\*)/g).map((part) =>
    part.startsWith('**') && part.endsWith('**')
      ? { bold: part.slice(2, -2) }
      : { bold: null, text: part },
  );
}

const centerName = (code: string) => frequencies.centers.find((c) => c.code === code)?.name ?? code;
---

<section data-methodology class="mx-auto max-w-3xl px-4 py-12">
  <h2 class="text-xl text-ink dark:text-paper">Methodik</h2>

  <dl class="mt-4 space-y-2 text-sm text-ink-700 dark:text-paper/90">
    <div class="flex gap-2">
      <dt class="font-medium text-ink-800 dark:text-paper">Quelle</dt>
      <dd>{frequencies.source}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-ink-800 dark:text-paper">Umfang</dt>
      <dd>{frequencies.n} Prüfungsprotokolle über {frequencies.centers.length} Zentren.</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-ink-800 dark:text-paper">Zeitraum</dt>
      <dd>{frequencies.period}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-medium text-ink-800 dark:text-paper">Stand</dt>
      <dd>{frequencies.generatedAt}</dd>
    </div>
  </dl>

  <p class="mt-4 text-sm text-ink-600 dark:text-paper/80">
    Die Summe der Berichte je Zentrum ({frequencies.nByCenterSum}) liegt über der
    Gesamtzahl der Protokolle ({frequencies.n}): ein Bericht kann in zwei Zentren
    zählen (z. B. bei einem Wechsel).
  </p>

  <h3 class="mt-8 text-lg text-ink dark:text-paper">Beobachtungen (Originalnotiz, FR)</h3>
  <ul class="mt-3 space-y-3 text-sm text-ink-700 dark:text-paper/90">
    {frequencies.trends.map((t) => (
      <li>
        <span class="font-mono text-xs text-ink-600 dark:text-paper/70">
          {t.center === 'all' ? 'Alle Zentren' : centerName(t.center)}
        </span>
        {' — '}
        {renderBold(t.summary).map((part) =>
          part.bold ? <strong>{part.bold}</strong> : part.text,
        )}
      </li>
    ))}
  </ul>

  <p class="mt-8 text-sm text-ink-600 dark:text-paper/80">{frequencies.disclaimer}</p>
</section>
