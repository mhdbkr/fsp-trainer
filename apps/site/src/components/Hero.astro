---
import { readSite } from '@/lib/site.ts';
import CtaButton from '@/components/CtaButton.astro';

const site = readSite();
---

{/* Premier écran = moment de marque : registre sombre (PHILOSOPHIE.md §04), aucune
    évocation animale, aucune explication de la métaphore. `.register-deep` fournit
    --surface / --on-surface / --on-surface-muted : le texte n'a pas à se colorer
    lui-même, il hérite du registre (et suit donc toute retouche de la pile pétrole).

    La formulation du corpus (« über 130 … real gestellte und realistisch mögliche »)
    n'est PAS ici : l'accueil la porte déjà deux fois plus bas (pilier 1 de
    `de/index.astro`, étape 1 de `Steps.astro`). Zéro doublon passe avant l'uniformité
    (MESSAGES.md §00). Le hero porte ce que lui seul peut porter : les cinq compétences. */}
<section class="register-deep">
  <div class="mx-auto max-w-5xl px-4 py-24 md:py-32">
    <h1 class="text-4xl leading-[1.05] tracking-[-0.03em] md:text-6xl">{site.tagline}.</h1>

    <p class="mt-6 max-w-2xl text-lg" style="color: var(--on-surface-muted)">
      Aussprache, Wortschatz, Grammatik, Redefluss, Kommunikation — fünf Kompetenzen,
      die die Prüfer einzeln bewerten. Du trainierst sie einzeln, und nach jedem
      Durchgang steht da, welche nachgegeben hat.
    </p>
    <p class="mt-3 max-w-2xl" style="color: var(--on-surface-muted)">
      Dein Plan rechnet von deinem Termin zurück und setzt genau dort an.
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-6">
      <CtaButton />
      <a href="/de/produkt/" class="underline underline-offset-4 hover:no-underline">So funktioniert es</a>
    </div>
  </div>
</section>
