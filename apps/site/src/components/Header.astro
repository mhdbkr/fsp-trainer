---
import { readSite } from '@/lib/site.ts';
import CtaButton from '@/components/CtaButton.astro';
import de from '@/i18n/de.json';

const site = readSite();
const navItems: [string, string][] = [
  [de.nav.produkt, '/de/#produkt'],
  [de.nav.wasDrankommt, '/de/was-drankommt/'],
  [de.nav.preise, '/de/preise/'],
  [de.nav.quickGuide, '/de/quick-guide/'],
  [de.nav.faq, '/de/faq/'],
  [de.nav.blog, '/de/blog/'],
];
---
<header data-glass class="glass sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/de/" class="font-display text-lg font-semibold text-brand-700">{site.brandName}</a>

    <nav class="hidden md:flex items-center gap-6 text-sm text-ink-700" aria-label="Hauptnavigation">
      {navItems.map(([label, href]) => (
        <a href={href} class="hover:text-brand-700 transition-colors duration-fast">{label}</a>
      ))}
    </nav>

    <CtaButton class="hidden md:inline-flex" />

    <details class="md:hidden">
      <summary class="list-none cursor-pointer rounded-control px-3 py-2 text-ink-700" aria-label="Menü öffnen">
        ☰
      </summary>
      <nav class="absolute inset-x-0 top-full flex flex-col gap-1 bg-paper p-4 shadow-lg" aria-label="Mobile Navigation">
        {navItems.map(([label, href]) => (
          <a href={href} class="rounded-control px-3 py-2 hover:bg-brand-50">{label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
