---
import { getCollection, render } from 'astro:content';

const entries = await getCollection('faq');
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(sorted.map(async (e) => ({ entry: e, Content: (await render(e)).Content })));

const CATEGORY_LABEL: Record<string, string> = {
  pruefung: 'Prüfung',
  produkt: 'Produkt',
  preise: 'Preise',
  konto: 'Konto',
};
---

<div class="mt-8 space-y-4">
  {rendered.map(({ entry, Content }) => (
    <details class="group rounded-control border border-ink-600/15 dark:border-paper/20">
      <summary class="cursor-pointer select-none px-4 py-3 text-ink dark:text-paper">
        <span class="mr-2 text-xs uppercase tracking-wide text-ink-600 dark:text-paper/70">{CATEGORY_LABEL[entry.data.category]}</span>
        {entry.data.question}
      </summary>
      <div class="prose prose-sm max-w-none border-t border-ink-600/15 px-4 py-4 text-ink-700 dark:border-paper/20 dark:text-paper/90">
        <Content />
      </div>
    </details>
  ))}
</div>
