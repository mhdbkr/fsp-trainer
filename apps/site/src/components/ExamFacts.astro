---
import exam from '@/data/exam-bw.json' with { type: 'json' };

const totalMinutes = exam.parts.reduce((sum, p) => sum + p.minutes, 0);
const isInternalScale = exam.pointsSource === 'intern';
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="rounded-card border border-brand-600/30 bg-brand-50 p-4 text-sm text-ink-700 dark:border-brand-300/30 dark:bg-brand-900/20 dark:text-paper/90">
    {exam.onlyLandNote}
  </div>

  <h2 class="mt-8 text-2xl md:text-3xl text-ink dark:text-paper">Der Ablauf</h2>
  <p class="mt-2 max-w-2xl text-ink-700 dark:text-paper/90">
    Die Prüfung dauert insgesamt {totalMinutes} Minuten und prüft {exam.assesses}.
  </p>

  <ol class="mt-6 grid gap-6 md:grid-cols-3">
    {exam.parts.map((p, i) => (
      <li class="card p-4">
        <span class="font-mono text-sm text-brand-700 dark:text-brand-300">{i + 1}</span>
        <h3 class="mt-1 text-lg text-ink dark:text-paper">{p.label}</h3>
        <p class="mt-1 text-sm text-ink-700 dark:text-paper/90">{p.minutes} Minuten</p>
      </li>
    ))}
  </ol>

  <div class="card mt-10">
    <h3 class="text-lg text-ink dark:text-paper">So bewerten wir im Trainer</h3>
    {isInternalScale ? (
      <p class="mt-2 max-w-2xl text-sm text-ink-700 dark:text-paper/90">
        Jede vollständige Simulation wird nach einer <strong>internen Übungsskala</strong> bewertet
        ({exam.totalPoints} Punkte, mindestens {exam.minPercentPerPart}% je Teil), aber
        <strong>kein offizielles Prüfungsergebnis</strong>.
      </p>
    ) : (
      <p class="mt-2 max-w-2xl text-sm text-ink-700 dark:text-paper/90">
        Jede vollständige Simulation wird Teil für Teil bewertet.
      </p>
    )}
  </div>

  <p class="mt-6 max-w-2xl text-sm text-ink-700 dark:text-paper/90">
    Zentren nach Erfahrungsberichten (Baden-Württemberg): {exam.centers.join(', ')}.
  </p>
</section>
