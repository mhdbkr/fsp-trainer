---
import pricing from '@/data/pricing.json' with { type: 'json' };

const cards = pricing.plans.map((plan) => ({
  ...plan,
  displayPrice: plan.price === '0' ? 'Kostenlos' : `${plan.price} / {{BILLING_PERIOD}}`,
  shown: plan.features.slice(0, 2).map((f) => ({
    label: pricing.labels[f.id] ?? f.id,
    bald: f.status === 'bald',
  })),
}));
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="text-2xl md:text-3xl text-ink-900 dark:text-paper">Preise</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {cards.map((card) => (
      <div class="rounded-card border border-ink-600/15 p-6 dark:border-paper/15">
        <h3 class="text-lg text-ink-900 dark:text-paper">{card.name}</h3>
        <p class="mt-1 font-mono text-xl text-ink-900 dark:text-paper">{card.displayPrice}</p>
        <ul class="mt-4 space-y-2 text-sm text-ink-700 dark:text-paper/90">
          {card.shown.map((f) => (
            <li>
              {f.label}
              {f.bald && <span class="ml-1 rounded-control bg-brand-50 px-1.5 py-0.5 text-xs text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">bald</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <a href="/de/preise/" class="mt-6 inline-block text-brand-700 underline hover:text-brand-800">
    Alle Preise ansehen
  </a>
</section>
