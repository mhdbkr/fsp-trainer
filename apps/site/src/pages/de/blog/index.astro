---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Blog | FSP Trainer"
  description="Beiträge von Doctopus zur Fachsprachprüfung: was drankommt, wie du dich vorbereitest."
  path="/de/blog/"
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-16">
    <h1 class="text-3xl md:text-4xl text-ink dark:text-paper">Blog</h1>
    <p class="mt-3 max-w-2xl text-ink-700 dark:text-paper/90">
      Beiträge von Doctopus rund um die Fachsprachprüfung.
    </p>

    {entries.length === 0 ? (
      <p class="mt-8 text-ink-700 dark:text-paper/90">Noch keine Beiträge.</p>
    ) : (
      <ul class="mt-8 space-y-6">
        {entries.map((e) => (
          <li>
            <a href={`/de/blog/${e.id}/`} class="block rounded-control border border-ink-600/15 px-4 py-4 hover:border-brand-600 dark:border-paper/20">
              <p class="text-sm text-ink-600 dark:text-paper/70">
                <time datetime={e.data.pubDate.toISOString()}>{e.data.pubDate.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              </p>
              <h2 class="mt-1 text-xl text-ink dark:text-paper">{e.data.title}</h2>
              <p class="mt-1 text-ink-700 dark:text-paper/90">{e.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
