---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Proof from '@/components/Proof.astro';
import Steps from '@/components/Steps.astro';
import PricingSummary from '@/components/PricingSummary.astro';
import FaqShort from '@/components/FaqShort.astro';
import LanguageToolNotice from '@/components/LanguageToolNotice.astro';
import { readSite } from '@/lib/site.ts';

const site = readSite();

const pillars = [
  {
    title: 'Was wirklich drankommt, zentrumsweise',
    copy: 'Über 130 vollständige Fälle — real gestellte und realistisch mögliche — laufend aktualisiert. Du siehst, was in Stuttgart am häufigsten gemeldet wurde, bevor du hinfährst.',
  },
  {
    title: 'Strukturiert wie die Prüfung, bewertet wie die Prüfung',
    copy: 'Drei Teile zu 20 Minuten, nach einer internen Übungsskala bewertet, angelehnt an den Prüfungsablauf. Verfügbare Bögen: Freiburg, Karlsruhe, Reutlingen, Stuttgart.',
  },
  {
    title: 'Dein Simulant ist um 23 Uhr verfügbar',
    copy: 'Simulation mit Partner (QR-Code auf dem Smartphone) oder allein im Modus Autonom.',
  },
];
---
<Base title={`${site.brandName} — ${site.tagline}`} description="Doctopus bereitet auf die Fachsprachprüfung Medizin vor." path="/de/">
  <Hero />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <ul class="grid gap-8 md:grid-cols-3">
      {pillars.map((p) => (
        <li>
          <h2 class="text-lg text-ink dark:text-paper">{p.title}</h2>
          <p class="mt-2 text-sm text-ink-700 dark:text-paper/90">{p.copy}</p>
        </li>
      ))}
    </ul>
  </section>

  <Proof />
  <Steps />
  <PricingSummary />
  <FaqShort />

  <div class="px-8 pb-8">
    <LanguageToolNotice />
  </div>
</Base>
