---
import Base from '@/layouts/Base.astro';
import FaqList from '@/components/FaqList.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('faq');
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);

// JSON-LD FAQPage généré depuis la collection — jamais dupliqué à la main.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: sorted.map((e) => ({
      '@type': 'Question',
      name: e.data.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: e.body?.replace(/\s+/g, ' ').trim() ?? '',
      },
    })),
  },
];
---

<Base
  title="FAQ | FSP Trainer"
  description="Häufige Fragen zu Prüfung, Produkt, Preisen und Konto von FSP Trainer."
  path="/de/faq/"
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-16">
    <h1 class="text-3xl md:text-4xl text-ink dark:text-paper">Häufige Fragen</h1>
    <p class="mt-3 max-w-2xl text-ink-700 dark:text-paper/90">
      Alles zu Prüfung, Produkt, Preisen und Konto.
    </p>
    <FaqList />
  </section>
</Base>
