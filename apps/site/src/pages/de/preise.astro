---
import Base from '@/layouts/Base.astro';
import PricingTable from '@/components/PricingTable.astro';
import CreditsExplainer from '@/components/CreditsExplainer.astro';

const faq = [
  {
    q: 'Bestanden?',
    a: 'Nach der Prüfung endet dein Plan zum Periodenende — keine weiteren Kosten.',
  },
  {
    q: 'Widerruf?',
    a: 'Du hast ein 14-tägiges Widerrufsrecht.',
    href: '/de/widerruf/',
    linkLabel: 'Mehr dazu in der Widerrufsbelehrung',
  },
];
---

<Base
  title="Preise | FSP Trainer"
  description="Free, Pro und Premium — Preise, Credits und Kündigung von FSP Trainer auf einen Blick."
  path="/de/preise/"
>
  <section class="mx-auto max-w-6xl px-4 pt-16">
    <h1 class="text-3xl md:text-4xl text-ink dark:text-paper">Preise</h1>
    <p class="mt-3 max-w-2xl text-ink-700 dark:text-paper/90">
      Free, Pro oder Premium — du wählst, wie lange du zahlst.
    </p>
  </section>

  <PricingTable />
  <CreditsExplainer />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-2xl md:text-3xl text-ink dark:text-paper">Häufige Fragen zu Preisen</h2>
    <div class="mt-8 space-y-4">
      {faq.map((item) => (
        <details class="group rounded-control border border-ink-600/15 dark:border-paper/20">
          <summary class="cursor-pointer select-none px-4 py-3 text-ink dark:text-paper">
            {item.q}
          </summary>
          <div class="border-t border-ink-600/15 px-4 py-4 text-ink-700 dark:border-paper/20 dark:text-paper/90">
            <p>{item.a}</p>
            {item.href && (
              <p class="mt-2">
                <a href={item.href} class="text-brand-700 underline hover:text-brand-800 dark:text-brand-300">{item.linkLabel}</a>
              </p>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>
