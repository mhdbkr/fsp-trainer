---
import Base from '@/layouts/Base.astro';
import { readSite } from '@/lib/site.ts';

const site = readSite();
const mailHref = `mailto:${site.supportEmail}`;
const reportHref = `mailto:${site.supportEmail}?subject=Inhalt%20melden`;

const faq = [
  {
    q: 'Wie schnell bekomme ich eine Antwort?',
    a: 'Antwort innerhalb von 2 Werktagen — bei hohem Aufkommen kann es länger dauern.',
  },
  {
    q: 'Wie kündige ich?',
    a: 'Kündigung jederzeit im Konto, ohne Begründung, wirksam zum Periodenende.',
  },
  {
    q: 'Ich habe einen Fehler in einem Fall gefunden — was jetzt?',
    a: 'Melde ihn direkt per E-Mail. Ein kurzer Hinweis reicht: welcher Fall, welche Stelle.',
  },
];
---

<Base
  title="Support | FSP Trainer"
  description="Kontakt, Antwortzeiten und wie du einen falschen Inhalt bei FSP Trainer meldest."
  path="/de/support/"
>
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <h1 class="text-3xl md:text-4xl text-ink dark:text-paper">Support</h1>
    <p class="mt-4 text-ink-700 dark:text-paper/90">
      Frage zu Konto, Zahlung oder Inhalt? Schreib uns direkt.
    </p>
    <div class="mt-6">
      <a
        href={mailHref}
        class="inline-flex rounded-control bg-brand-600 px-5 py-3 text-paper font-medium hover:bg-brand-700 transition-colors duration-fast"
      >
        {site.supportEmail}
      </a>
    </div>
    <p class="mt-3 text-sm text-ink-600 dark:text-paper/80">
      In der Regel Antwort innerhalb von 2 Werktagen.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-8">
    <h2 class="text-2xl md:text-3xl text-ink dark:text-paper">Falschen Inhalt melden</h2>
    <p class="mt-3 text-ink-700 dark:text-paper/90">
      Ein Fall, ein Begriff oder ein Leitfaden ist fehlerhaft oder veraltet? Melde es — jeder
      Hinweis fließt in die nächste Durchsicht ein.
    </p>
    <div class="mt-4">
      <a href={reportHref} class="text-brand-700 underline hover:text-brand-800 dark:text-brand-300">
        Inhalt melden ({site.supportEmail})
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-2xl md:text-3xl text-ink dark:text-paper">Häufige Fragen</h2>
    <div class="mt-8 space-y-4">
      {faq.map((item) => (
        <details class="group rounded-control border border-ink-600/15 dark:border-paper/20">
          <summary class="cursor-pointer select-none px-4 py-3 text-ink dark:text-paper">
            {item.q}
          </summary>
          <div class="border-t border-ink-600/15 px-4 py-4 text-ink-700 dark:border-paper/20 dark:text-paper/90">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>
