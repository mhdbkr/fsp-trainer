---
import Base from '@/layouts/Base.astro';
---
<Base title="Seite nicht gefunden" description="Diese Seite existiert nicht oder wurde verschoben." path="/404/">
  <div class="mx-auto max-w-2xl px-4 py-16 text-center">
    <h1 class="text-3xl font-display font-semibold text-brand-700">Seite nicht gefunden</h1>
    <p class="mt-4 text-ink-600">Diese Seite existiert nicht oder wurde verschoben.</p>
    <a href="/de/" class="mt-6 inline-block text-brand-700 underline">Zurück zur Startseite</a>
  </div>
</Base>
