{
  "$version": "0.1.0",
  "$source": {
    "note": "Chaque valeur est copiée de l'app. `line` = ligne du fichier source au commit e2a2c70 (main). Toute modification ici DOIT être répercutée dans l'app tant que la migration apps/app n'est pas faite (check-parity.mjs veille).",
    "tailwind": "app/tailwind.config.js",
    "css": "app/src/styles/index.css"
  },
  "color": {
    "brand": {
      "$src": "tailwind:11-14",
      "50": "#ecf7f4", "100": "#cfeae4", "200": "#a2d7cd", "300": "#6bbdb0",
      "400": "#379e8f", "500": "#158375", "600": "#0c6157", "700": "#0b4e46",
      "800": "#0d3f3a", "900": "#0e3530", "950": "#041e1b"
    },
    "signal": {
      "$src": "tailwind:18-21",
      "50": "#fdf1ec", "100": "#fbdfd3", "200": "#f6bda7", "300": "#f09374",
      "400": "#e8613c", "500": "#d84a24", "600": "#bf3a19", "700": "#9e2d17",
      "800": "#80271a", "900": "#6a2418", "950": "#3a0f0a"
    },
    "paper": { "$src": "tailwind:24", "DEFAULT": "#f4f5f2" },
    "ink": {
      "$src": "tailwind:25-26",
      "DEFAULT": "#0c1a17", "800": "#12211e", "700": "#1b2f2b", "600": "#26403a"
    },
    "focus": {
      "$src": "css:7,13",
      "light": "#0c6157",
      "dark": "#6bbdb0"
    }
  },
  "font": {
    "$src": "tailwind:31-35",
    "sans": "\"IBM Plex Sans Variable\", system-ui, -apple-system, Segoe UI, sans-serif",
    "display": "\"Bricolage Grotesque Variable\", \"IBM Plex Sans Variable\", system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, monospace"
  },
  "type": {
    "$src": "tailwind:44 ; css:54-58",
    "headingTracking": "-0.014em",
    "headingWeight": "600"
  },
  "motion": {
    "$src": "tailwind:41 ; css:8-10",
    "easeFluid": "cubic-bezier(0.32, 0.72, 0, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationFast": "130ms",
    "duration": "200ms"
  },
  "radius": {
    "$src": "css:89 (.card rounded-xl) ; css:139 (.btn rounded-lg) — valeurs par défaut Tailwind 3.4",
    "card": "0.75rem",
    "control": "0.5rem"
  },
  "glass": {
    "$src": "css:207-222 (.glass) ; css:251-257 (replis)",
    "blur": "20px",
    "saturate": "180%",
    "light": {
      "background": "rgb(255 255 255 / 0.60)",
      "border": "rgb(255 255 255 / 0.55)",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.65), 0 10px 34px -14px rgb(4 30 27 / 0.28)",
      "fallback": "rgb(244 245 242 / 0.98)"
    },
    "dark": {
      "background": "rgb(18 33 30 / 0.58)",
      "border": "rgb(255 255 255 / 0.10)",
      "shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.08), 0 10px 34px -14px rgb(0 0 0 / 0.55)",
      "fallback": "rgb(18 33 30 / 0.98)"
    },
    "tint": { "$src": "css:246-247", "light": "rgb(21 131 117 / 0.16)", "dark": "rgb(21 131 117 / 0.20)" }
  },
  "card": {
    "$src": "css:88-96 ; css:108-114",
    "blur": "16px",
    "saturate": "160%",
    "light": { "background": "rgb(255 255 255 / 0.72)", "border": "rgb(255 255 255 / 0.60)" },
    "dark": { "background": "rgb(18 33 30 / 0.55)", "border": "rgb(255 255 255 / 0.08)" }
  }
}
